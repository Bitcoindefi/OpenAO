# Server & Network Configuration
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aoweb
TOKEN_AUTH=changeme
CORS_ORIGIN=http://localhost:3000

# Base URL for Email Links (e.g. Password Reset)
# In production must be: https://openao.cosmosapp.lat
SITE_URL=http://localhost:3000

# Amazon SES Email Delivery (Required for password recovery in production)
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=soporte@openao.cosmosapp.lat
SES_FROM_NAME=OpenAO

# Game Data Admin Proxy & Audit Configuration (Optional)
GAME_DATA_ADMIN_EMAIL=
GAME_DATA_ADMIN_ACCOUNT_ID=
GAME_DATA_ADMIN_PROXY_TOKEN=

# Database Connection Pool Tuning
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
