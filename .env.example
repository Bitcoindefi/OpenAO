# ============================================================
# OpenAO / AOWeb 鈥?Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---------- Server ----------
PORT=3001

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/openao
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_IN_TX_TIMEOUT_MS=10000

# ---------- Authentication ----------
TOKEN_AUTH=your-secret-token-here

# ---------- CORS ----------
CORS_ORIGIN=*

# ---------- Site URL (used for password reset links) ----------
# ⚠️ CRITICAL: Must be set correctly for password reset emails!
# If this points to the wrong URL, reset links will not work.
# Default is "https://aoweb.app" which may not match your deployment.
# SITE_URL=https://openao.cosmosapp.lat   # <-- CHANGE THIS to your actual deployment URL

# ---------- Amazon SES (required for password reset email) ----------
# To enable password reset, you MUST configure Amazon Simple Email Service.
# 1. Create an AWS account: https://aws.amazon.com
# 2. Go to SES Console and verify your sender email/domain
# 3. Create IAM credentials with ses:SendEmail permission
# 4. Fill in the values below:
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=your-access-key-id
SES_SECRET_ACCESS_KEY=your-secret-access-key
SES_FROM_EMAIL=noreply@openao.cosmosapp.lat
SES_FROM_NAME=AOWeb

# ---------- Game Data Admin ----------
GAME_DATA_ADMIN_EMAIL=
GAME_DATA_ADMIN_ACCOUNT_ID=
GAME_DATA_ADMIN_PROXY_TOKEN=